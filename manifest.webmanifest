{
  "name": "Tikify",
  "short_name": "Tikify",
  "description": "Save TikTok sounds and play them like music. Make playlists, listen offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#121212",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/library.jpg", "sizes": "1080x1920", "type": "image/jpeg", "form_factor": "narrow", "label": "Your sounds, sorted into playlists" },
    { "src": "screenshots/playlist.jpg", "sizes": "1080x1920", "type": "image/jpeg", "form_factor": "narrow", "label": "Play a playlist with shuffle and repeat" },
    { "src": "screenshots/player.jpg", "sizes": "1080x1920", "type": "image/jpeg", "form_factor": "narrow", "label": "Full-screen player that works offline" }
  ],
  "shortcuts": [
    { "name": "Add sound", "url": "./#/add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "All sounds", "url": "./#/all", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
